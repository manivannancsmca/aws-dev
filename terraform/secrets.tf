# -----------------------------------------------------------------------------
# Database credentials in AWS Secrets Manager.
# The password is generated by Terraform, never typed by a human and never
# stored in a file. ECS injects it into the container as DB_PASSWORD.
# -----------------------------------------------------------------------------
resource "random_password" "db" {
  length  = 24
  special = true
  # RDS forbids '/', '@', '"' and spaces in passwords
  override_special = "!#$%^&*()-_=+[]{}<>:?"
}

resource "aws_secretsmanager_secret" "db" {
  name        = "${local.name_prefix}/db-credentials"
  description = "RDS MySQL credentials for ${local.name_prefix}"

  # 0 = delete immediately (dev). Default is 30 days, which blocks re-creating a secret with the same name.
  recovery_window_in_days = var.secret_recovery_window_days
}

# The secret value is a JSON document; ECS can pick individual keys ("username", "password")
resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id
  secret_string = jsonencode({
    username = var.db_username
    password = random_password.db.result
  })
}
