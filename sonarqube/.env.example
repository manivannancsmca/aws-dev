# Copy this file to ".env" (same folder) and adjust if needed.
# These values are for the LOCAL SonarQube stack only. Never commit a real .env file.

# Login for SonarQube's own PostgreSQL database (not your SonarQube web login)
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar_pass

# Host port for the SonarQube web UI and API (change it if 9000 is already in use)
SONAR_HOST_PORT=9000
