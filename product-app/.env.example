# Copy this file to ".env" (same folder) and adjust if needed.
# These values are for LOCAL use only (Docker Compose, SonarQube scan). Never commit a real .env file.
MYSQL_DATABASE=productdb
MYSQL_USER=product_user
MYSQL_PASSWORD=product_pass
MYSQL_ROOT_PASSWORD=root_pass

# Host ports (change if something on your machine already uses them)
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8080

# SonarQube analysis token, read by sonar-scan.cmd / sonar-scan.sh (NOT by Docker Compose).
# Create it in SonarQube: My Account -> Security -> Generate Tokens. Paste it after "=",
# with no spaces and no quotes. Never commit it.
SONAR_TOKEN=
